        def refresh_list(self, fetch_limits: bool = False):
            accounts, _ = list_accounts()
            ready = sum(1 for a in accounts if (self.limits_cache.get(a["id_key"]) or {}).get("ok") and min(self.limits_cache[a["id_key"]].get("rem_5h", 0), self.limits_cache[a["id_key"]].get("rem_weekly", 0)) > get_auto_config().get("codex_threshold", 2))
            self.account_summary.set_text(f"{len(accounts)} saved accounts  ·  {ready} available  ·  Refreshing usage" if fetch_limits else f"{len(accounts)} saved accounts  ·  {ready} available")

            t_info = get_active_or_interrupted_codex_thread(max_age_seconds=86400, include_recent_completed=True)
            if t_info:
                st_map = {
                    "inProgress": "⚡ Running",
                    "interrupted": "⏸ Interrupted",
                    "failed": "🛑 Rate limited" if t_info.get("is_rate_limit") else "⚠ Failed",
                    "completed": "✓ Latest chat",
                }
                st_txt = st_map.get(t_info.get("status", ""), t_info.get("status", ""))
                self.codex_active_task_row.set_subtitle(
                    f"{st_txt}: \"{t_info['title']}\" ({t_info['thread_id'][:8]}...)"
                )
            else:
                self.codex_active_task_row.set_subtitle("No active or interrupted Codex chat found")

            for r in self.account_rows:
                self.accounts_group.remove(r)
            self.account_rows.clear()

            if not accounts:
                empty_row = Adw.ActionRow()
                empty_row.set_title("No saved accounts")
                empty_row.set_subtitle("Choose Add account to save your first account")
                self.accounts_group.add(empty_row)
                self.account_rows.append(empty_row)
            else:
                for acc in accounts:
                    row = self.build_account_card(acc)
                    self.accounts_group.add(row)
                    self.account_rows.append(row)

            if fetch_limits and not self.fetching_limits and accounts:
                self.fetching_limits = True
                self.header_spinner.start()

                def worker(accs_snapshot):
                    res = fetch_all_limits_parallel(accs_snapshot)
                    GLib.idle_add(self.on_limits_fetched, res)

                threading.Thread(target=worker, args=(accounts,), daemon=True).start()



        # ---------------- AUTOMATION & RESUME HANDLERS ---------------- #
        def on_codex_resume_toggled(self, switch_row, _pspec):
            save_auto_config({"codex_auto_resume": switch_row.get_active()})


        def on_manual_codex_resume(self, *_):
            t_info = get_active_or_interrupted_codex_thread(max_age_seconds=86400, include_recent_completed=True)
            if not t_info:
                self.show_toast("No Codex chat found to resume.")
                return
            self.show_toast(f"Resuming Codex chat: {t_info['title']}...")

            def worker():
                res = resume_codex_thread(t_info["thread_id"], cwd=t_info.get("cwd"), wait_for_app_seconds=4.0)
                GLib.idle_add(
                    self.show_toast,
                    f"Codex continuation sent ({res.get('method', 'ok')})!"
                    if res.get("ok")
                    else f"Error: {res.get('error')}",
                )

            threading.Thread(target=worker, daemon=True).start()


        def refresh_automation_status(self):
            st = get_auto_service_status()
            if st["active"]:
                self.svc_status_row.set_subtitle("🟢 Running and monitoring usage")
                self.svc_toggle_btn.set_label("Stop service")
                self.svc_toggle_btn.remove_css_class("suggested-action")
