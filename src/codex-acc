def _resolve_root_codex_thread(conn_state: sqlite3.Connection, thread_id: str) -> dict | None:
    cur = conn_state.cursor()
    visited = set()
    curr_id = thread_id
    last_row = None
    while curr_id and curr_id not in visited:
        visited.add(curr_id)
        cur.execute(
            "SELECT id, title, cwd, sandbox_policy, approval_mode, source, thread_source, updated_at "
            "FROM threads WHERE id = ?",
            (curr_id,),
        )
        row = cur.fetchone()
        if not row:
            break
        last_row = row
        t_source = row[6] or ""
        raw_src = row[5] or ""
        if t_source == "subagent" and raw_src.startswith("{"):
            try:
                sdata = json.loads(raw_src)
                parent_id = ((sdata.get("subagent") or {}).get("thread_spawn") or {}).get("parent_thread_id")
                if parent_id:
                    curr_id = parent_id
                    continue
            except Exception:
                pass
        break

    if not last_row:
        return None
    return {
        "thread_id": last_row[0],
        "title": (last_row[1] or "Untitled Codex chat").strip().splitlines()[0][:80],
        "cwd": last_row[2] or str(Path.home()),
        "sandbox_policy": last_row[3] or "",
        "approval_mode": last_row[4] or "",
        "thread_source": last_row[6] or "user",
        "updated_at": last_row[7] or 0,
    }


def get_active_or_interrupted_codex_threads(
    max_age_seconds: int = 3600,
    include_recent_completed: bool = False,
) -> list[dict]:
    """Snapshot every unfinished root chat, using only its latest turn.

    A long-running turn is fresh when its thread or rollout was updated recently.
    Archived chats and finished parent chats are never resumed via old child turns.
    """
    hist_db = CODEX_DIR / "thread_history_1.sqlite"
    state_db = CODEX_DIR / "state_5.sqlite"
    if not state_db.exists():
        return []
    cutoff = int(time.time()) - max_age_seconds
    candidates = []
    try:
        with closing(sqlite3.connect(state_db.as_uri() + "?mode=ro", uri=True, timeout=3)) as state:
            turns = []
            if hist_db.exists():
                with closing(sqlite3.connect(hist_db.as_uri() + "?mode=ro", uri=True, timeout=3)) as hist:
                    turns = hist.execute("""
                        WITH latest AS (
                            SELECT *, ROW_NUMBER() OVER (
                                PARTITION BY thread_id ORDER BY rollout_ordinal DESC,
                                COALESCE(completed_at, started_at, 0) DESC
                            ) AS rn FROM thread_turns
                        )
                        SELECT thread_id, status, error_json, started_at, completed_at
                        FROM latest WHERE rn = 1
                        ORDER BY COALESCE(completed_at, started_at, 0) DESC
                    """).fetchall()
            roots = {}
            for tid, status, error_json, started, completed in turns:
                info = _resolve_root_codex_thread(state, tid)
                if not info:
                    continue
                root_id = info["thread_id"]
                root = state.execute(
                    "SELECT archived, rollout_path FROM threads WHERE id = ?", (root_id,)
                ).fetchone()
                if not root or root[0] or info.get("thread_source") != "user":
                    continue
                ts = max(started or 0, completed or 0)
                record = (info, status, error_json or "", ts, root[1], tid == root_id)
                previous = roots.get(root_id)
                # The root's own latest turn is authoritative over any child.
                if previous is None or (record[5] and not previous[5]):
                    roots[root_id] = record
            for info, status, error, ts, rollout_path, _ in roots.values():
                is_rl = any(term in error.lower() for term in ("usagelimitexceeded", "rate_limit", "quota"))
                fresh = ts >= cutoff
                if status == "inProgress":
                    fresh = fresh or info.get("updated_at", 0) >= cutoff
                    if not fresh and rollout_path:
                        try:
                            fresh = Path(rollout_path).stat().st_mtime >= cutoff
                        except OSError:
                            pass
                unfinished = status in ("inProgress", "interrupted") or (status == "failed" and is_rl)
                if fresh and (unfinished or include_recent_completed):
                    priority = (0 if status == "inProgress" else 1 if is_rl else 2) if unfinished else 9
                    info.update(status=status, is_rate_limit=is_rl, last_turn_ts=ts, priority=priority)
                    candidates.append(info)
            if not candidates and include_recent_completed:
                row = state.execute(
                    "SELECT id FROM threads WHERE archived = 0 AND thread_source = 'user' "
                    "ORDER BY updated_at DESC LIMIT 1"
                ).fetchone()
                info = _resolve_root_codex_thread(state, row[0]) if row else None
                if info:
                    info.update(status="completed", is_rate_limit=False, priority=9, last_turn_ts=0)
                    candidates.append(info)
    except (sqlite3.Error, OSError):
        return []
    return sorted(candidates, key=lambda info: (info["priority"], -info["last_turn_ts"]))


def get_active_or_interrupted_codex_thread(
    max_age_seconds: int = 3600,
    include_recent_completed: bool = False,
) -> dict | None:
    threads = get_active_or_interrupted_codex_threads(max_age_seconds, include_recent_completed)
    return threads[0] if threads else None


def resume_codex_threads(
    threads: list[dict], prompt: str | None = None, wait_for_app_seconds: float = 18.0,
) -> list[dict]:
    """Continue each captured root once; a failed chat does not block the rest."""
    results = []
    seen = set()
    for thread in threads:
        tid = thread.get("thread_id")
        if not tid or tid in seen:
            continue
        seen.add(tid)
        try:
            result = resume_codex_thread(
                tid, prompt=prompt, cwd=thread.get("cwd"),
                wait_for_app_seconds=wait_for_app_seconds,
            )
        except Exception as exc:
            result = {"ok": False, "method": "desktop_error", "thread_id": tid, "error": str(exc)}
        results.append(result)
    return results


def _ipc_send_frame(sock: socket.socket, obj: dict):
    raw = json.dumps(obj).encode("utf-8")
    sock.sendall(struct.pack("<I", len(raw)) + raw)


def _ipc_recv_frame(sock: socket.socket, timeout: float = 3.0) -> dict | None:
    sock.settimeout(timeout)
    hdr = b""
    while len(hdr) < 4:
        chunk = sock.recv(4 - len(hdr))
        if not chunk:
            return None
        hdr += chunk
    length = struct.unpack("<I", hdr)[0]
    if length > 8 * 1024 * 1024:
        raise ValueError("IPC response too large")
    body = b""
    while len(body) < length:
        chunk = sock.recv(length - len(body))
        if not chunk:
            return None
        body += chunk
    return json.loads(body.decode("utf-8", errors="ignore"))


def _try_codex_ipc_start_turn(
    thread_id: str, prompt: str, *, probe_only: bool = False
) -> tuple[bool, str]:
    ipc_sock_path = CODEX_DIR / "ipc" / "ipc.sock"
    if not ipc_sock_path.exists():
        return False, "ipc_sock_yok"
    s = None
    turn_sent = False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(str(ipc_sock_path))
        init_req_id = str(uuid.uuid4())
        _ipc_send_frame(
            s,
            {
                "type": "request",
                "requestId": init_req_id,
                "sourceClientId": "initializing-client",
                "version": 1,
                "method": "initialize",
                "params": {"clientType": "cli"},
            },
        )
        init_resp = _ipc_recv_frame(s, timeout=2.5)
        if not init_resp or init_resp.get("resultType") != "success":
            s.close()
            return False, "ipc_init_basarisiz"
        client_id = (init_resp.get("result") or {}).get("clientId")
        if not client_id:
            s.close()
            return False, "ipc_client_id_yok"

        disc_req_id = str(uuid.uuid4())
        _ipc_send_frame(
            s,
            {
                "type": "request",
                "requestId": disc_req_id,
                "sourceClientId": client_id,
                "version": 1,
                "method": "thread-owner-discovery",
                "params": {"hostId": "local", "conversationId": thread_id},
            },
        )
        owner_id = None
        for _ in range(5):
            msg = _ipc_recv_frame(s, timeout=2.0)
            if not msg:
                break
            if msg.get("requestId") == disc_req_id and msg.get("type") == "response":
                if msg.get("resultType") == "success":
                    owner_id = msg.get("handledByClientId") or (
                        (msg.get("result") or {}).get("ownerClientId")
                    )
                break
        if not owner_id:
            s.close()
            return False, "ipc_owner_bulunamadi"
        if probe_only:
            return True, "ipc_desktop_owner_hazir"

        turn_req_id = str(uuid.uuid4())
        # Once sending starts, an absent acknowledgement must never cause a
        # second turn or a separate writer to be launched for the same thread.
        turn_sent = True
        _ipc_send_frame(
            s,
            {
                "type": "request",
                "requestId": turn_req_id,
                "sourceClientId": client_id,
                "version": 2,
                "method": "thread-follower-start-turn",
                "targetClientId": owner_id,
                "params": {
                    "conversationId": thread_id,
                    "turnStart": {
                        "request": {
                            "threadId": thread_id,
                            "input": [{"type": "text", "text": prompt, "text_elements": []}],
                        },
                        "context": {"inheritThreadSettings": True},
                    },
                },
            },
        )
        for _ in range(6):
            msg = _ipc_recv_frame(s, timeout=3.0)
            if not msg:
                break
            if msg.get("requestId") == turn_req_id and msg.get("type") == "response":
                s.close()
                if msg.get("resultType") == "success":
                    return True, "ipc_desktop"
                return False, f"ipc_hata:{msg.get('error')}"
        s.close()
        return False, "ipc_gonderim_belirsiz"
    except Exception as e:
        if turn_sent:
            return False, "ipc_gonderim_belirsiz"
        return False, f"ipc_istisna:{e}"
    finally:
        if s is not None:
            s.close()


def _open_codex_thread_in_desktop(thread_id: str):
    # The installed app handles this URI and loads the thread in its own
    # app-server, including the desktop tools and browser context.
    thread_id = str(uuid.UUID(thread_id))
    subprocess.Popen(
        ["xdg-open", f"codex://threads/{thread_id}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def resume_codex_thread(
    thread_id: str,
    prompt: str | None = None,
    cwd: str | None = None,
    wait_for_app_seconds: float = 15.0,
) -> dict:
    """
    Continues a Codex thread automatically after an account switch.
    Opens the saved thread in Desktop, waits for its IPC owner, then sends one
    continuation request. It never creates a competing background CLI writer.
    A missing acknowledgement is reported as unconfirmed and is not retried.
    """
    cfg = get_auto_config()
    resume_text = (prompt or cfg.get("resume_prompt") or DEFAULT_AUTO_CONFIG["resume_prompt"]).strip()
    deadline = time.monotonic() + max(1.0, wait_for_app_seconds)
    last_reason = "bekleniyor"
    opened_thread = False
    while time.monotonic() < deadline:
        if is_chatgpt_app_running():
            ok, reason = _try_codex_ipc_start_turn(thread_id, resume_text)
            last_reason = reason
            if ok:
                try:
                    subprocess.Popen(
                        [
                            "notify-send",
                            "-i",
                            "chatgpt",
                            "Codex chat resuming",
                            f"Chat ({thread_id[:8]}...) resumed with the selected account.",
                        ],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )
                except Exception:
                    pass
                return {"ok": True, "method": reason, "thread_id": thread_id}
            if reason == "ipc_gonderim_belirsiz" or reason.startswith("ipc_hata:"):
                # Delivery may have succeeded even if the connection closed.
                # Do not repeat the prompt or start a second owner.
                return {
                    "ok": False,
                    "method": "desktop_unconfirmed" if reason == "ipc_gonderim_belirsiz" else "desktop_rejected",
                    "thread_id": thread_id,
                    "error": "Desktop continuation was not acknowledged; it was not sent again.",
                    "ipc_reason": reason,
                }
            if reason == "ipc_owner_bulunamadi" and not opened_thread:
                try:
                    _open_codex_thread_in_desktop(thread_id)
                    opened_thread = True
                    # A freshly restarted app may need time to load the saved
                    # thread and reclaim its writer lease.
                    deadline = max(deadline, time.monotonic() + 45.0)
                except Exception as e:
                    last_reason = f"desktop_acilamadi:{e}"
        time.sleep(1.2)

    try:
        subprocess.Popen(
            [
                "notify-send", "-i", "chatgpt",
                "Codex continuation pending",
                "Account changed, but the desktop chat could not resume. Open the chat and try again.",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass
    return {
        "ok": False,
        "method": "desktop_pending",
        "thread_id": thread_id,
        "error": "Desktop chat connection was not ready; continuation was not sent.",
        "ipc_reason": last_reason,
    }


