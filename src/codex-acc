def print_accounts_cli():
    accounts, _ = list_accounts()
    if not accounts:
        print("No saved Codex accounts. To add one: codex-acc add")
    else:
        limits_map = fetch_all_limits_parallel(accounts)
        print("\nSaved ChatGPT (Codex) accounts, usage, and reset credits:")
        print("=" * 84)
        for idx, acc in enumerate(accounts, 1):
            mark = "★ [ACTIVE]" if acc["is_active"] else "         "
            name_part = f" ({acc['name']})" if acc.get("name") else ""
            until_part = f" | Ends: {acc['sub_until']}" if acc.get("sub_until") else ""
            lim = limits_map.get(acc["id_key"]) or {}
            if lim.get("ok"):
                r5 = lim["rem_5h"]
                rw = lim["rem_weekly"]
                rst5 = f" (resets: {lim['reset_5h']})" if lim.get("reset_5h") and r5 < 100 else ""
                rstw = f" (resets: {lim['reset_weekly']})" if lim.get("reset_weekly") and rw < 100 else ""
                status_tag = "🔴 LIMIT REACHED" if lim.get("limit_reached") or r5 == 0 or rw == 0 else "🟢 AVAILABLE"
                lim_str = f"    ↳ {status_tag}  |  5-hour: %{r5} Remaining{rst5}  |  Weekly: %{rw} Remaining{rstw}"
                r_avail = lim.get("reset_available", 0)
                g_30d = lim.get("granted_30d_count", 0)
                if r_avail > 0:
                    exp_s = f" (expires: {lim['reset_expires']})" if lim.get("reset_expires") else ""
                    rst_info = f"🎁 {r_avail} reset credits available{exp_s}"
                elif g_30d > 0:
                    rst_info = (
                        f"0 available (in the last 30 days: {g_30d} granted | | "
                        f"Last granted: {lim.get('last_granted_str', '-')}, used: {lim.get('last_used_str', '-')})"
                    )
                else:
                    rst_info = "0 available (no reset credits granted yet)"
                lim_str += f"\n    ↳ 🔄 Reset credits: {rst_info}"
            else:
                lim_str = f"    ↳ Usage unavailable: {lim.get('error', 'Unknown error')}"
            print(f" {idx}) {mark} {acc['email']}{name_part} [{acc['plan']}{until_part}]")
            print(lim_str)
        print("=" * 84)

    return accounts


def cli_add(private: bool = True):
    sync_current_auth()
    backup = AUTH_FILE.read_bytes() if AUTH_FILE.exists() else None
    if AUTH_FILE.exists():
        AUTH_FILE.unlink()

    print("Your current account is backed up. Opening the browser for sign-in...")
    env = os.environ.copy()
    env["BROWSER"] = "/bin/true"
    proc = subprocess.Popen(
        [CODEX_BIN, "login"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        env=env,
    )
    opened = False
    try:
        for line in proc.stdout:
            m = re.search(r"(https://auth\.openai\.com/\S+|http://localhost:\d+/\S+)", line)
            if m and not opened:
                opened = True
                url = m.group(1).strip()
                print(f"\nSign-in link:\n{add_prompt_login(url)}\n")
                open_url_in_browser(url, private=private)
        rc = proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        rc = 1

    if rc == 0 and AUTH_FILE.exists():
        info = sync_current_auth()
        if info:
            restart_chatgpt_app(start_if_closed=False)
            print(f"\n✓ New account saved and selected: {info['email']} ({info['plan']})")
            return
    if backup and not AUTH_FILE.exists():
        AUTH_FILE.write_bytes(backup)
        os.chmod(AUTH_FILE, 0o600)
    print("\n✕ Sign-in cancelled; previous account preserved.")


def main():
    if any(arg in ("--help", "-h") for arg in sys.argv[1:]):
        print("Codex Account Center (unofficial)\nUsage: codex-acc [gui | list | add | switch ACCOUNT | resume]")
        return
    ensure_dirs()
    sync_current_auth()

    args = sys.argv[1:]
    if not args or args[0] in ("gui", "app"):
        run_gui()
        return

    cmd = args[0]
    if cmd in ("list", "ls", "status"):
        print_accounts_cli()
        return

    if cmd in ("add", "login", "new"):
        private = "--normal" not in args
        cli_add(private=private)
        return

    if cmd in ("resume", "continue"):
        t_info = get_active_or_interrupted_codex_thread(max_age_seconds=86400, include_recent_completed=True)
        if not t_info:
            print("No Codex chat found to resume.")
            return
        res = resume_codex_thread(t_info["thread_id"], cwd=t_info.get("cwd"))
        print(json.dumps(res, ensure_ascii=False))
        return

    if cmd in ("switch", "use"):
        target_arg = args[1] if len(args) > 1 else ""
    else:
        target_arg = cmd

    accounts, _ = list_accounts()
    if not target_arg:
        accounts = print_accounts_cli()
        if not accounts:
            return
        try:
            target_arg = input("Account number to switch to (or 'a' to add one): ").strip()
        except EOFError:
            return
        if target_arg.lower() == "a":
            cli_add(private=True)
            return

    chosen = None
    if target_arg.isdigit():
        idx = int(target_arg) - 1
        if 0 <= idx < len(accounts):
            chosen = accounts[idx]
    if not chosen:
        for acc in accounts:
            if target_arg.lower() in acc["email"].lower() or target_arg.lower() in acc.get("alias", "").lower():
                chosen = acc
                break

    if not chosen:
        print(f"Account not found: '{target_arg}'")
        print_accounts_cli()
        sys.exit(1)

    switch_to_account(chosen, restart_app=True)
    print(f"✓ Active account changed: {chosen['email']} ({chosen['plan']})")


if __name__ == "__main__":
    main()
