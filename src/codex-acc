def parse_auth_data(data: dict) -> dict:
    tokens = data.get("tokens") or {}
    id_claims = decode_jwt_payload(tokens.get("id_token", ""))
    access_claims = decode_jwt_payload(tokens.get("access_token", ""))

    auth_info = (
        id_claims.get("https://api.openai.com/auth")
        or access_claims.get("https://api.openai.com/auth")
        or {}
    )

    email = id_claims.get("email") or access_claims.get("email") or ""
    name = id_claims.get("name") or ""
    plan = (auth_info.get("chatgpt_plan_type") or "").upper()
    sub_until_raw = auth_info.get("chatgpt_subscription_active_until") or ""
    sub_until = ""
    if sub_until_raw:
        try:
            dt = datetime.fromisoformat(sub_until_raw.replace("Z", "+00:00"))
            sub_until = dt.strftime("%d.%m.%Y")
        except Exception:
            sub_until = sub_until_raw[:10]

    account_id = (
        tokens.get("account_id")
        or auth_info.get("chatgpt_account_id")
        or id_claims.get("sub")
        or ""
    )
    user_id = auth_info.get("user_id") or id_claims.get("sub") or ""

    orgs = auth_info.get("organizations") or []
    org_title = ""
    for org in orgs:
        if org.get("is_default"):
            org_title = org.get("title") or ""
            break
    if not org_title and orgs:
        org_title = orgs[0].get("title") or ""

    if not email and data.get("OPENAI_API_KEY"):
        key = data["OPENAI_API_KEY"]
        email = "API key " + hashlib.sha256(key.encode()).hexdigest()[:10]
        plan = "API"

    key_slug = email if email else (account_id[:12] if account_id else "unknown")
    safe_filename = re.sub(r"[^a-zA-Z0-9_.@-]", "_", key_slug)

    return {
        "email": email or "Unknown account",
        "name": name,
        "plan": plan or "CHATGPT",
        "sub_until": sub_until,
        "account_id": account_id,
        "user_id": user_id,
        "org_title": org_title,
        "safe_filename": safe_filename,
        "last_refresh": data.get("last_refresh") or "",
    }


def refresh_account_tokens(file_path: Path, data: dict) -> dict | None:
    tokens = data.get("tokens") or {}
    refresh_tok = tokens.get("refresh_token")
    if not refresh_tok:
        return None
    payload = json.dumps(
        {
            "client_id": OAUTH_CLIENT_ID,
            "grant_type": "refresh_token",
            "refresh_token": refresh_tok,
        }
    ).encode("utf-8")
    req = urllib.request.Request(
        TOKEN_URL,
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "codex-cli/1.0",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            res = json.loads(resp.read().decode("utf-8"))
        if "access_token" in res:
            tokens["access_token"] = res["access_token"]
        if "id_token" in res:
            tokens["id_token"] = res["id_token"]
        if "refresh_token" in res:
            tokens["refresh_token"] = res["refresh_token"]
        data["tokens"] = tokens
        data["last_refresh"] = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
        raw = json.dumps(data, indent=2)
        file_path.write_text(raw, encoding="utf-8")
        os.chmod(file_path, 0o600)

        if AUTH_FILE.exists():
            try:
                cur = json.loads(AUTH_FILE.read_text(encoding="utf-8"))
                if (cur.get("tokens") or {}).get("account_id") == tokens.get("account_id"):
                    AUTH_FILE.write_text(raw, encoding="utf-8")
                    os.chmod(AUTH_FILE, 0o600)
            except Exception:
                pass
        return data
    except Exception:
        return None


def fetch_account_limits(acc: dict) -> dict:
    """
    Calls https://chatgpt.com/backend-api/wham/usage for a saved account file
    and parses both 5-hour (18000s) and weekly (604800s) remaining percentages.
    """
    file_path = Path(acc["file_path"])
    try:
        data = json.loads(file_path.read_text(encoding="utf-8"))
    except Exception as e:
        return {"ok": False, "error": str(e)}

    tokens = data.get("tokens") or {}
    access_token = tokens.get("access_token")
    account_id = tokens.get("account_id") or acc.get("account_id")
    if not access_token:
        return {"ok": False, "error": "No access token"}

    def _call_wham(path: str, tok: str, method: str = "GET", body: dict | None = None):
        headers = {
            "Authorization": f"Bearer {tok}",
            "Accept": "application/json",
            "User-Agent": "codex-cli/1.0",
        }
        if account_id:
            headers["ChatGPT-Account-Id"] = account_id
        data_bytes = None
        if body is not None:
            headers["Content-Type"] = "application/json"
            data_bytes = json.dumps(body).encode("utf-8")
        req = urllib.request.Request(
            f"https://chatgpt.com/backend-api/wham/{path.lstrip('/')}",
            data=data_bytes,
            headers=headers,
            method=method,
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            return json.loads(resp.read().decode("utf-8"))

    active_tok = access_token
    try:
        usage = _call_wham("usage", active_tok)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            refreshed = refresh_account_tokens(file_path, data)
            if refreshed:
                active_tok = refreshed["tokens"]["access_token"]
                try:
                    usage = _call_wham("usage", active_tok)
                except Exception as e2:
                    return {"ok": False, "error": f"Error after refresh: {e2}"}
            else:
                return {"ok": False, "error": "Session expired (sign in again)"}
        else:
            return {"ok": False, "error": f"HTTP {e.code}"}
    except Exception as e:
        return {"ok": False, "error": str(e)}

    rl = usage.get("rate_limit") or {}
    allowed = rl.get("allowed", True)
    limit_reached = rl.get("limit_reached", False)

    win_5h = None
    win_weekly = None

    for key in ("primary_window", "secondary_window"):
        w = rl.get(key)
        if not w:
            continue
        secs = w.get("limit_window_seconds") or 0
        if secs <= 86400:
            win_5h = w
        else:
            win_weekly = w

    if not win_5h and not win_weekly:
        return {"ok": False, "error": "No usage windows reported", "plan_type": (usage.get("plan_type") or "").upper()}
    if any("used_percent" not in w or w["used_percent"] is None for w in (win_5h, win_weekly) if w):
        return {"ok": False, "error": "Usage percentage unavailable"}
    has_5h_cap = win_5h is not None
    if win_5h:
        used_5h = int(round(win_5h.get("used_percent") or 0))
        rem_5h = max(0, 100 - used_5h)
        reset_5h = format_duration_tr(win_5h.get("reset_after_seconds"))
    else:
        used_5h = 0
        rem_5h = 100
        reset_5h = ""

    if win_weekly:
        used_wk = int(round(win_weekly.get("used_percent") or 0))
        rem_wk = max(0, 100 - used_wk)
        reset_wk = format_duration_tr(win_weekly.get("reset_after_seconds"))
    else:
        used_wk = 0
        rem_wk = 100
        reset_wk = ""

    # Parse rate_limit_reset_credits, extra credits, and reset history
    rc_summary = usage.get("rate_limit_reset_credits") or {}
    reset_available = int(rc_summary.get("available_count") or 0)
    reset_applicable = int(rc_summary.get("applicable_available_count") or 0)
    reset_total_earned = 0
    reset_credit_id = None
    reset_expires_str = ""

    try:
        rc_detail = _call_wham("rate-limit-reset-credits", active_tok)
        reset_available = max(reset_available, int(rc_detail.get("available_count") or 0))
        reset_total_earned = int(rc_detail.get("total_earned_count") or 0)
        avail_list = [c for c in (rc_detail.get("credits") or []) if c.get("status") == "available"]
        if avail_list:
            reset_credit_id = avail_list[0].get("id")
            exp_raw = avail_list[0].get("expires_at")
            if exp_raw:
                reset_expires_str = format_iso_reset_tr(exp_raw)
    except Exception:
        pass

    granted_30d_count = 0
    used_30d_count = 0
    last_granted_str = ""
    last_used_str = ""

    def _fmt_local_dt(iso_s: str | None) -> str:
        if not iso_s:
            return ""
        try:
            dt = datetime.fromisoformat(iso_s.replace("Z", "+00:00")).astimezone()
            return dt.strftime("%d.%m.%Y %H:%M")
        except Exception:
            return iso_s[:10]

    try:
        rc_hist = _call_wham("rate-limit-reset-credits/history", active_tok)
        events = rc_hist.get("events") or []
        granted_ev = [ev for ev in events if ev.get("kind") == "granted"]
        used_ev = [ev for ev in events if ev.get("kind") == "used"]
        granted_30d_count = len(granted_ev)
        used_30d_count = len(used_ev)
        if granted_ev:
            last_granted_str = _fmt_local_dt(granted_ev[0].get("occurred_at"))
        if used_ev:
            last_used_str = _fmt_local_dt(used_ev[0].get("occurred_at"))
    except Exception:
        pass

    credits_obj = usage.get("credits") or {}
    has_credits = bool(credits_obj.get("has_credits")) or bool(credits_obj.get("unlimited"))
    credits_balance = str(credits_obj.get("balance") or "0")
    promo_obj = usage.get("promo")

    return {
        "ok": True,
        "allowed": allowed and not limit_reached,
        "limit_reached": limit_reached,
        "has_5h_cap": has_5h_cap,
        "has_weekly_cap": win_weekly is not None,
        "rem_5h": rem_5h,
        "used_5h": used_5h,
        "reset_5h": reset_5h,
        "rem_weekly": rem_wk,
        "used_weekly": used_wk,
        "reset_weekly": reset_wk,
        "plan_type": (usage.get("plan_type") or "").upper(),
        "reset_available": reset_available,
        "reset_applicable": reset_applicable,
        "reset_total_earned": max(reset_total_earned, granted_30d_count),
        "reset_credit_id": reset_credit_id,
        "reset_expires": reset_expires_str,
        "granted_30d_count": granted_30d_count,
        "used_30d_count": used_30d_count,
        "last_granted_str": last_granted_str,
        "last_used_str": last_used_str,
        "has_credits": has_credits,
        "credits_balance": credits_balance,
        "promo": promo_obj,
    }


def consume_codex_reset_credit(acc: dict, credit_id: str | None = None) -> dict:
    """
    Redeems an available Codex rate-limit reset credit via
    POST https://chatgpt.com/backend-api/wham/rate-limit-reset-credits/consume
    """
    file_path = Path(acc["file_path"])
    try:
        data = json.loads(file_path.read_text(encoding="utf-8"))
        tokens = data.get("tokens") or {}
        access_token = tokens.get("access_token")
        account_id = tokens.get("account_id") or acc.get("account_id")
        if not access_token:
            return {"ok": False, "error": "No access token"}
        headers = {
            "Authorization": f"Bearer {access_token}",
            "Accept": "application/json",
            "Content-Type": "application/json",
            "User-Agent": "codex-cli/1.0",
        }
        if account_id:
            headers["ChatGPT-Account-Id"] = account_id
        payload = json.dumps(
            {
                "credit_id": credit_id,
                "redeem_request_id": str(uuid.uuid4()),
            }
        ).encode("utf-8")
        req = urllib.request.Request(
            "https://chatgpt.com/backend-api/wham/rate-limit-reset-credits/consume",
            data=payload,
            headers=headers,
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            res = json.loads(resp.read().decode("utf-8"))
        return {"ok": True, "code": res.get("code", "reset"), "response": res}
    except Exception as e:
        return {"ok": False, "error": str(e)}


def fetch_all_limits_parallel(accounts: list[dict]) -> dict[str, dict]:
    results = {}
    if not accounts:
        return results
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as ex:
        fut_map = {ex.submit(fetch_account_limits, acc): acc["id_key"] for acc in accounts}
        for fut in concurrent.futures.as_completed(fut_map):
            key = fut_map[fut]
            try:
                results[key] = fut.result()
            except Exception as e:
                results[key] = {"ok": False, "error": str(e)}
    return results


def sync_current_auth() -> dict | None:
    """
    Reads ~/.codex/auth.json and saves/updates its corresponding profile in ~/.codex/accounts/
    so rotated refresh_tokens are never lost.
    """
    ensure_dirs()
    if not AUTH_FILE.exists():
        return None
    try:
        raw = AUTH_FILE.read_text(encoding="utf-8")
        data = json.loads(raw)
        if not data.get("tokens") and not data.get("OPENAI_API_KEY"):
            return None
        info = parse_auth_data(data)
        target = ACCOUNTS_DIR / f"{info['safe_filename']}.json"
        target.write_text(raw, encoding="utf-8")
        os.chmod(target, 0o600)
        info["file_path"] = str(target)
        info["id_key"] = target.stem
        return info
    except Exception:
        return None


def list_accounts() -> tuple[list[dict], dict | None]:
    ensure_dirs()
    current = sync_current_auth()
    meta = load_meta()
    aliases = meta.get("aliases") or {}

    accounts = []
    for p in sorted(ACCOUNTS_DIR.glob("*.json")):
        if p.name.startswith("_"):
            continue
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
            info = parse_auth_data(data)
            info["file_path"] = str(p)
            info["id_key"] = p.stem
            info["alias"] = aliases.get(p.stem, "")
            is_active = False
            if current:
                if current.get("email") == info.get("email") and current.get("account_id") == info.get("account_id"):
                    is_active = True
            info["is_active"] = is_active
            accounts.append(info)
        except Exception:
            continue

    accounts.sort(key=lambda x: (0 if x["is_active"] else 1, x["email"].lower()))
    return accounts, current


def _chatgpt_main_pids() -> list[int]:
    """Exclude Electron renderer/zygote processes and other users' sessions."""
    found = []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid != os.getuid():
                continue
            if proc.joinpath("exe").resolve() != Path("/usr/lib/chatgpt/ChatGPT"):
                continue
            args = proc.joinpath("cmdline").read_bytes().split(b"\0")
            if not args or any(re.search(rb"(?:^|\s)--type=", arg) for arg in args):
                continue
            if proc.joinpath("stat").read_text().split(") ", 1)[1].startswith("Z"):
                continue
            found.append(int(proc.name))
        except (OSError, IndexError):
            pass
    return found


def is_chatgpt_app_running() -> bool:
    return bool(_chatgpt_main_pids())


def _desktop_launch_environment() -> dict[str, str]:
    """Refresh the watcher environment after graphical-session login.

    A boot-started user service can lack DISPLAY/WAYLAND_DISPLAY indefinitely.
    Import only display-session variables, never another process's credentials.
    """
    env = os.environ.copy()
    keys = {"DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "XDG_SESSION_TYPE",
            "DBUS_SESSION_BUS_ADDRESS", "HYPRLAND_INSTANCE_SIGNATURE", "XAUTHORITY"}
    try:
        manager = subprocess.run(["systemctl", "--user", "show-environment"],
                                 capture_output=True, text=True, timeout=3)
        for line in manager.stdout.splitlines():
            key, sep, value = line.partition("=")
            if sep and key in keys and value:
                env[key] = value
    except (OSError, subprocess.TimeoutExpired):
        pass
    runtime = Path(env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
    env["XDG_RUNTIME_DIR"] = str(runtime)
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={runtime}/bus")
    display = env.get("WAYLAND_DISPLAY", "")
    if not display or not (runtime / display).is_socket():
        sockets = [p for p in runtime.glob("wayland-*") if p.is_socket()]
        if len(sockets) == 1:
            env["WAYLAND_DISPLAY"] = sockets[0].name
        else:
            env.pop("WAYLAND_DISPLAY", None)
    if env.get("WAYLAND_DISPLAY"):
        env["XDG_SESSION_TYPE"] = "wayland"
    env.pop("ELECTRON_RUN_AS_NODE", None)
    return env


def _desktop_ipc_ready() -> bool:
    """A read-only handshake proves the app server is accepting connections."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(0.7)
        sock.connect(str(CODEX_DIR / "ipc" / "ipc.sock"))
        rid = str(uuid.uuid4())
        _ipc_send_frame(sock, {"type": "request", "requestId": rid,
            "sourceClientId": "initializing-client", "version": 1,
            "method": "initialize", "params": {"clientType": "cli"}})
        response = _ipc_recv_frame(sock, timeout=0.7)
        return bool(response and response.get("requestId") == rid
                    and response.get("resultType") == "success")
    except (OSError, ValueError):
        return False
    finally:
        sock.close()


def _desktop_window_ready(env: dict) -> bool:
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE") or not shutil.which("hyprctl"):
        return True  # Other desktops rely on the main-process + IPC checks.
    try:
        result = subprocess.run(["hyprctl", "clients", "-j"], env=env,
                                capture_output=True, text=True, timeout=2)
        if result.returncode:
            return False
        return any(w.get("mapped") and w.get("class", "").lower() == "chatgpt"
                   for w in json.loads(result.stdout))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False


def _stop_chatgpt_app():
    """Stop the desktop and only its descendants; wait out Electron shutdown."""
    roots = set(_chatgpt_main_pids())
    if not roots:
        return
    children = set(roots)
    parents = {}
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid == os.getuid():
                parents[int(proc.name)] = int(proc.joinpath("stat").read_text().split(") ", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            pass
    for _ in range(12):
        additions = {pid for pid, parent in parents.items() if parent in children} - children
        if not additions:
            break
        children.update(additions)
    for pid in roots:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + 10
    while is_chatgpt_app_running() and time.monotonic() < deadline:
        time.sleep(0.2)
    # Never pkill every codex app-server: unrelated CLI sessions may own one.
    for pid in children:
        try:
            os.kill(pid, signal.SIGKILL if pid in roots else signal.SIGTERM)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + 3
    while is_chatgpt_app_running() and time.monotonic() < deadline:
        time.sleep(0.1)
    if is_chatgpt_app_running():
        raise RuntimeError("Codex could not close. Restart cancelled.")


def _launch_chatgpt_and_wait(env: dict, timeout: float = 35.0) -> dict:
    log_dir = Path.home() / ".local" / "state" / "codex-acc"
    log_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    log_path = log_dir / "desktop-launch.log"
    # Record launcher stderr locally, never print authentication data to the UI.
    if log_path.exists() and log_path.stat().st_size > 512_000:
        log_path.write_bytes(b"")
    with log_path.open("ab") as log:
        os.chmod(log_path, 0o600)
        proc = subprocess.Popen(["/usr/bin/chatgpt"], env=env, stdout=log, stderr=log,
                                start_new_session=True)
    deadline = time.monotonic() + max(1.0, timeout)
    while time.monotonic() < deadline:
        if is_chatgpt_app_running() and _desktop_ipc_ready() and _desktop_window_ready(env):
            return {"ok": True, "app_ready": True, "method": "desktop_window_and_ipc"}
        code = proc.poll()
        if code is not None and code != 0 and not is_chatgpt_app_running():
            raise RuntimeError(f"Codex could not launch (exit {code}). Launch log: {log_path}")
        time.sleep(0.4)
    raise RuntimeError(f"Codex did not become ready. Launch log: {log_path}")


def restart_chatgpt_app(start_if_closed: bool = False):
    running = is_chatgpt_app_running()
    if not running and not start_if_closed:
        return {"ok": True, "app_ready": False, "method": "app_was_closed"}
    env = _desktop_launch_environment()
    _stop_chatgpt_app()
    return _launch_chatgpt_and_wait(env)


def switch_to_account(account_info: dict, restart_app: bool = True, start_app_if_closed: bool = False):
    # Serialize the GUI and background watcher's account transitions.
    CODEX_DIR.mkdir(parents=True, exist_ok=True)
    with (CODEX_DIR / "account-switch.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("Another account switch is in progress. Wait for it to finish.")
        src = Path(account_info["file_path"])
        if not src.exists():
            raise FileNotFoundError(f"Account file not found: {src}")
        # Validate before stopping a healthy app; synchronize only after shutdown
        # so its final save cannot overwrite the newly selected credentials.
        json.loads(src.read_text(encoding="utf-8"))
        launch = restart_app or start_app_if_closed
        env = _desktop_launch_environment() if launch else None
        if launch:
            _stop_chatgpt_app()
        sync_current_auth()
        raw = src.read_text(encoding="utf-8")
        tmp = CODEX_DIR / "auth.json.tmp"
        tmp.write_text(raw, encoding="utf-8")
        os.chmod(tmp, 0o600)
        tmp.replace(AUTH_FILE)
        try:
            result = _launch_chatgpt_and_wait(env) if launch else {"ok": True, "app_ready": False}
        except Exception as exc:
            raise RuntimeError(f"Account selected, but Codex could not open. {exc}") from exc
        try:
            subprocess.Popen(["notify-send", "-i", "chatgpt",
                "Codex ready" if result["app_ready"] else "Codex account selected",
                f"{account_info['email']} · " + ("App opened." if result["app_ready"] else "Restart disabled.")],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
        return result


