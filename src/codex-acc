def add_prompt_login(url: str) -> str:
    try:
        parsed = urlparse(url)
        q = dict(parse_qsl(parsed.query, keep_blank_values=True))
        if "accounts.google.com" not in parsed.netloc:
            q["prompt"] = "login"
        new_query = urlencode(q)
        return urlunparse(parsed._replace(query=new_query))
    except Exception:
        return url


def open_url_in_browser(url: str, private: bool = True):
    login_url = add_prompt_login(url)
    if private:
        for cmd, flag in [
            ("zen-browser", "--private-window"),
            ("firefox", "--private-window"),
            ("chromium", "--incognito"),
            ("google-chrome", "--incognito"),
            ("brave", "--incognito"),
        ]:
            if shutil.which(cmd):
                subprocess.Popen(
                    [cmd, flag, login_url],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
                return
    subprocess.Popen(
        ["xdg-open", login_url],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )






