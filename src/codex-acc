                self.svc_toggle_btn.add_css_class("suggested-action")

            self.log_label.set_label(get_recent_auto_service_logs(16))

        def on_toggle_auto_service(self, *_):
            st = get_auto_service_status()
            ok, msg = set_auto_service_enabled(not st["active"])
            self.refresh_automation_status()
