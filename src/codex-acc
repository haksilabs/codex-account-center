        def build_account_card(self, acc: dict) -> Gtk.Widget:
            row = Gtk.ListBoxRow(activatable=False, selectable=False)
            row.add_css_class("account-entry")
            if acc["is_active"]:
                row.add_css_class("account-current")
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            for side in ("top", "bottom", "start", "end"):
                getattr(card, "set_margin_" + side)(18)
            row.set_child(card)
            identity = Gtk.Box(spacing=12)
            name = acc.get("name") or acc["email"].split("@")[0]
            avatar = Adw.Avatar.new(38, name, True)
            avatar.set_valign(Gtk.Align.START)
            identity.append(avatar)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, hexpand=True)
            title = Gtk.Label(label=name, xalign=0, wrap=True)
            title.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
            title.add_css_class("identity-name")
            text.append(title)
            email = Gtk.Label(label=acc["email"], xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
            email.set_tooltip_text(acc["email"])
            email.add_css_class("dim-label")
            email.add_css_class("caption")
            text.append(email)
            identity.append(text)
            lim = self.limits_cache.get(acc["id_key"])
            plan = str((lim or {}).get("plan_type") or "").upper()
            plan_badge = Gtk.Label(label=plan or "UNKNOWN PLAN", valign=Gtk.Align.START)
            plan_badge.add_css_class("badge-pro" if plan.startswith("PRO") else "badge-plus" if plan == "PLUS" else "badge-neutral")
            plan_badge.set_tooltip_text("Current plan reported by the service" if plan else "Plan has not been verified")
            identity.append(plan_badge)
            if acc["is_active"]:
                status, css = "ACTIVE", "badge-active"
            elif lim and lim.get("ok"):
                rem = min(lim.get("rem_5h", 100), lim.get("rem_weekly", 100))
                status, css = ("LIMIT REACHED", "badge-err") if rem <= 0 or lim.get("limit_reached") else (("LOW USAGE", "badge-warn") if rem <= 25 else ("READY", "badge-ok"))
            else:
                status, css = "CHECKING", "badge-neutral"
            badge = Gtk.Label(label=status, valign=Gtk.Align.START)
            badge.add_css_class(css)
            identity.append(badge)
            card.append(identity)
            if lim and lim.get("ok"):
                quotas = Gtk.Box(spacing=24, homogeneous=True)
                for label, pct, reset in (("5-hour", lim["rem_5h"], lim.get("reset_5h", "")),
                                           ("Weekly", lim["rem_weekly"], lim.get("reset_weekly", ""))):
                    column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, hexpand=True)
                    column.add_css_class("quota-block")
                    heading = Gtk.Box(spacing=8)
                    caption = Gtk.Label(label=label, xalign=0, hexpand=True)
                    caption.add_css_class("dim-label")
                    heading.append(caption)
                    reported = lim.get("has_5h_cap" if label == "5-hour" else "has_weekly_cap", True)
                    number = Gtk.Label(label=f"{pct}%" if reported else "—")
                    number.add_css_class("quota-number")
                    heading.append(number)
                    column.append(heading)
                    bar = Gtk.ProgressBar(fraction=max(0,min(1,pct/100)) if reported else 0)
                    bar.add_css_class("bar-err" if pct <= 2 else "bar-warn" if pct <= 25 else "bar-ok")
                    column.append(bar)
                    reset_label = Gtk.Label(label=(f"{reset} until renewal" if reset and pct < 100 else "Ready to use") if reported else "No window reported", xalign=0, wrap=True)
                    reset_label.add_css_class("caption")
                    reset_label.add_css_class("dim-label")
                    column.append(reset_label)
                    quotas.append(column)
                card.append(quotas)
            else:
