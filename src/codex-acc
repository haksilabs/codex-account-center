def save_auto_config(new_cfg: dict) -> dict:
    meta = load_meta()
    cfg = dict(DEFAULT_AUTO_CONFIG)
    cfg.update(meta.get("auto_switch_config") or {})
    cfg.update(new_cfg)
    meta["auto_switch_config"] = cfg
    save_meta(meta)
    return cfg


