        def make_limit_bar_row(self, title: str, rem_pct: int, reset_str: str, note: str = "") -> Gtk.Box:
            row_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)

            top_line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            lbl_left = Gtk.Label(label=title)
            lbl_left.set_halign(Gtk.Align.START)
            lbl_left.set_hexpand(False)
            lbl_left.add_css_class("caption")
            top_line.append(lbl_left)

            right_txt = f"{rem_pct}% remaining"
            if reset_str and rem_pct < 100:
                right_txt += f"  •  Resets: {reset_str}"
            elif note:
                right_txt += f"  •  {note}"
            lbl_right = Gtk.Label(label=right_txt, wrap=True, xalign=1)
            lbl_right.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
            lbl_right.set_hexpand(True)
            lbl_right.set_halign(Gtk.Align.END)
            lbl_right.add_css_class("caption-heading")
            top_line.append(lbl_right)

            pbar = Gtk.ProgressBar()
            pbar.set_fraction(max(0.0, min(1.0, rem_pct / 100.0)))
            if rem_pct <= 2:
                pbar.add_css_class("bar-err")
            elif rem_pct <= 25:
                pbar.add_css_class("bar-warn")
            else:
                pbar.add_css_class("bar-ok")

            row_box.append(top_line)
            row_box.append(pbar)
            return row_box

