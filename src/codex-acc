def get_auto_service_status() -> dict:
    try:
        res = subprocess.run(
            ["systemctl", "--user", "is-active", "codex-auto-switch.service"],
            capture_output=True,
            text=True,
            timeout=3,
        )
        active = res.stdout.strip() == "active"
        en_res = subprocess.run(
            ["systemctl", "--user", "is-enabled", "codex-auto-switch.service"],
            capture_output=True,
            text=True,
            timeout=3,
        )
        enabled = en_res.stdout.strip() == "enabled"
        return {"active": active, "enabled": enabled, "state": res.stdout.strip()}
    except Exception as e:
        return {"active": False, "enabled": False, "state": str(e)}


def set_auto_service_enabled(enable: bool) -> tuple[bool, str]:
    try:
        subprocess.run(["systemctl", "--user", "daemon-reload"], timeout=4)
        action = "enable" if enable else "disable"
        res = subprocess.run(
            ["systemctl", "--user", action, "--now", "codex-auto-switch.service"],
            capture_output=True,
            text=True,
            timeout=6,
        )
        if res.returncode == 0:
            return True, "Service started and enabled." if enable else "Service stopped."
        return False, res.stderr.strip() or "systemctl error"
    except Exception as e:
        return False, str(e)


def restart_auto_service_if_active():
    st = get_auto_service_status()
    if st.get("active"):
        try:
            subprocess.run(["systemctl", "--user", "restart", "codex-auto-switch.service"], timeout=5)
        except Exception:
            pass


def get_recent_auto_service_logs(lines: int = 18) -> str:
    try:
        res = subprocess.run(
            ["journalctl", "--user", "-u", "codex-auto-switch.service", "-n", str(lines), "--no-pager", "-o", "cat"],
            capture_output=True,
            text=True,
            timeout=4,
        )
        out = res.stdout.strip()
        return out if out else "No activity yet."
    except Exception as e:
        return f"Could not read log: {e}"


