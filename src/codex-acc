        def on_limits_fetched(self, res: dict[str, dict]):
            self.fetching_limits = False
            self.header_spinner.stop()
            self.limits_cache.update(res)
            self.refresh_list(fetch_limits=False)

        def on_use_reset_credit(self, acc: dict, credit_id: str | None = None):
            self.show_toast(f"{acc['email']}: using a usage reset credit...")

            def worker():
                res = consume_codex_reset_credit(acc, credit_id)
                if res.get("ok"):
                    GLib.idle_add(self.show_toast, f"✓ {acc['email']}: usage reset successfully.")
                    GLib.idle_add(self.refresh_list, True)
                else:
                    GLib.idle_add(self.show_toast, f"Could not use reset credit: {res.get('error')}")

            threading.Thread(target=worker, daemon=True).start()

        def on_switch_clicked(self, acc: dict, force_start: bool = False):
            if getattr(self, "switching_account", False):
                self.show_toast("Switching account…")
                return
            active_threads = get_active_or_interrupted_codex_threads(max_age_seconds=3600)
            do_resume = self.codex_resume_switch_row.get_active()
            restart_app = self.restart_switch_row.get_active()
            self.switching_account = True
            self.accounts_group.set_sensitive(False)
            self.switch_status.set_label("Switching account · Waiting for Codex to open…")
            self.switch_status.set_visible(True)
            def worker():
                try:
                    result = switch_to_account(acc, restart_app=restart_app, start_app_if_closed=force_start)
                except Exception as exc:
                    GLib.idle_add(self.on_switch_finished, False, str(exc))
                    return
                message = f"{acc['email']} · Codex is open and ready." if result.get("app_ready") else f"{acc['email']} selected. Restart disabled."
                GLib.idle_add(self.on_switch_finished, True, message)
                if do_resume and active_threads and result.get("app_ready"):
                    resume_codex_threads(active_threads, wait_for_app_seconds=18.0)
            threading.Thread(target=worker, daemon=True).start()

        def on_switch_finished(self, ok, message):
            self.switching_account = False
            self.accounts_group.set_sensitive(True)
            self.switch_status.set_label(message)
            self.switch_status.set_visible(True)
            if ok:
                self.switch_status.remove_css_class("error")
            else:
                self.switch_status.add_css_class("error")
            self.show_toast(message)
            self.refresh_list(fetch_limits=ok)
            return False

        def on_delete_clicked(self, acc: dict):
            try:
                p = Path(acc["file_path"])
                if p.exists():
                    p.unlink()
                self.refresh_list(fetch_limits=False)
                self.show_toast(f"{acc['email']} removed from the list.")
            except Exception as e:
                self.show_toast(f"Could not remove account: {e}")

        def on_copy_login_url(self, *_):
            if not self.last_oauth_url:
                self.show_toast("Sign-in link is not ready yet")
                return
            url = add_prompt_login(self.last_oauth_url)
            clipboard = Gdk.Display.get_default().get_clipboard()
            clipboard.set(url)
            self.show_toast("Sign-in link copied.")

        def start_login_flow(self, private: bool = True):
            if self.login_proc is not None:
                self.show_toast("A sign-in is already in progress.")
                return

            sync_current_auth()
            self.backup_auth_bytes = AUTH_FILE.read_bytes() if AUTH_FILE.exists() else None
            if AUTH_FILE.exists():
                AUTH_FILE.unlink()

            self.last_oauth_url = None
            self.login_status_group.set_visible(True)
            self.add_priv_btn.set_sensitive(False)
            self.add_norm_btn.set_sensitive(False)

            env = os.environ.copy()
            env["BROWSER"] = "/bin/true"

            def worker():
                try:
                    proc = subprocess.Popen(
                        [CODEX_BIN, "login"],
                        stdout=subprocess.PIPE,
                        stderr=subprocess.STDOUT,
                        text=True,
                        env=env,
                    )
                    self.login_proc = proc
                    url_opened = False
                    for line in proc.stdout:
                        m = re.search(r"(https://auth\.openai\.com/\S+|http://localhost:\d+/\S+)", line)
                        if m and not url_opened:
                            url_opened = True
                            url = m.group(1).strip()
                            self.last_oauth_url = url
                            GLib.idle_add(open_url_in_browser, url, private)

                    rc = proc.wait()
                    self.login_proc = None
                    GLib.idle_add(self.on_login_finished, rc == 0)
                except Exception as e:
                    self.login_proc = None
                    GLib.idle_add(self.on_login_finished, False, str(e))

            threading.Thread(target=worker, daemon=True).start()

        def on_login_finished(self, success: bool, err_msg: str = ""):
            self.login_status_group.set_visible(False)
            self.add_priv_btn.set_sensitive(True)
            self.add_norm_btn.set_sensitive(True)

            if success and AUTH_FILE.exists():
                info = sync_current_auth()
                if info:
                    if self.restart_switch_row.get_active():
                        restart_chatgpt_app(start_if_closed=False)
                    self.refresh_list(fetch_limits=True)
                    self.show_toast(f"Account added and activated: {info['email']}")
                    return

            if self.backup_auth_bytes and not AUTH_FILE.exists():
                AUTH_FILE.write_bytes(self.backup_auth_bytes)
                os.chmod(AUTH_FILE, 0o600)
            self.refresh_list(fetch_limits=False)
            if err_msg:
                self.show_toast(f"Sign-in failed: {err_msg}")
            else:
                self.show_toast("Sign-in cancelled; previous account restored.")

        def cancel_login_flow(self):
            if self.login_proc:
                try:
                    self.login_proc.terminate()
                except Exception:
                    pass

    app = UnifiedAccountSwitcherApp()
    app.run([])


